<?xml version="1.0" encoding="utf-8"?>
<!-- Heads-up content can be limited to 88dp; alarm identity stays in the system header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Button
        android:id="@+id/notification_start"
        style="@style/AlarmNotificationButton.Start"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/notification_start"
        android:textSize="16sp" />

    <include
        layout="@layout/notification_alarm_secondary_actions"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
