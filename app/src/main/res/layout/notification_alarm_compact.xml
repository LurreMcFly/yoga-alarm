<?xml version="1.0" encoding="utf-8"?>
<!-- Keep every available action inside the 48dp collapsed content area. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal">

    <Button
        android:id="@+id/notification_start"
        style="@style/AlarmNotificationButton.Start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/notification_start" />

    <FrameLayout
        android:id="@+id/notification_stop_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/notification_stop"
            style="@style/AlarmNotificationButton.Stop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/notification_stop" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/notification_snooze_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1.4">

        <Button
            android:id="@+id/notification_snooze"
            style="@style/AlarmNotificationButton.Snooze"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/notification_snooze" />
    </FrameLayout>
</LinearLayout>
